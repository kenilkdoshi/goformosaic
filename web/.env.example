# Copy to .env.local for `npm run dev` (and .env for Prisma CLI).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goformosaic

# Azurite (docker compose up). In Azure these are replaced by managed identity.
STORAGE_ACCOUNT_NAME=devstoreaccount1
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
UPLOADS_CONTAINER=uploads
PROCESSING_QUEUE=image-processing

SITE_URL=http://localhost:3000

# Leave empty locally: Turnstile is skipped outside production. Cloudflare test keys also work:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA  TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Leave empty to log emails to the console.
ACS_CONNECTION_STRING=
EMAIL_FROM=DoNotReply@goformosaic.com
ADMIN_NOTIFY_EMAIL=admin@example.com

# /admin locally without Entra (ignored when NODE_ENV=production).
ADMIN_DEV_BYPASS=true
ADMIN_OBJECT_ID=

BOOKING_URL=https://goformosaic.com/book
EMAIL_SIGNATURE_NAME=Kenil
PRIVACY_CONTACT_EMAIL=privacy@goformosaic.com
RETENTION_DAYS=90
