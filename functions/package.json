{
  "name": "goformosaic-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/functions/*.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "heic-decode": "^2.1.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
