{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request;Exception" }
    }
  },
  "extensions": {
    "queues": {
      "batchSize": 2,
      "newBatchThreshold": 1,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:30"
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
